# 环境变量示例：复制为 .env 后填写，重启生效。
# 不填也能运行，系统会自动降级到演示数据源。

# 数据源顺序：auto / amap / baidu / osm / demo
MAP_PROVIDER=auto

# ---------------- 高德 ----------------
# Web 服务 Key：服务端 POI 搜索、路径规划、地理编码
AMAP_WEB_KEY=
# Web 端 (JS API) Key：前端内嵌地图（可选，不填则用自绘 SVG 地图）
AMAP_JS_KEY=
# JS API 安全密钥（可选）
AMAP_JS_SECURITY_CODE=

# ---------------- 百度 ----------------
# 服务端 AK
BAIDU_WEB_AK=
# 浏览器端 AK（可选）
BAIDU_JS_AK=

# ---------------- 容错参数 ----------------
# 对外请求最小间隔（秒），不建议低于 1
REQUEST_INTERVAL=1.0
# 单个数据源重试次数
MAX_RETRY=2
# 单次请求超时（秒）
REQUEST_TIMEOUT=6.0

# ---------------- 默认位置 ----------------
# 定位失败且用户未手动选择时的兜底中心（望京 SOHO）
DEFAULT_CITY=北京
DEFAULT_AREA=望京
DEFAULT_LAT=39.9963
DEFAULT_LNG=116.4703

# 是否允许降级到演示数据（0 = 不允许，全部真实源失败即报错）
ALLOW_DEMO_FALLBACK=1

# ---------------- 安全与限流 ----------------
# 单 IP 每分钟 API 请求上限（0 = 关闭）
RATE_LIMIT_PER_MINUTE=300
# 搜索接口单独限流，避免刷爆上游地图配额
SEARCH_RATE_LIMIT_PER_MINUTE=40
# 部署在 Nginx 等反向代理后设为 1，正确读取客户端 IP
TRUST_PROXY=0
# 内容安全策略开关；地图 SDK 异常时可临时设为 0 排查
CSP_ENABLED=1

# ---------------- 持久化与会话 ----------------
# SQLite 文件路径；容器内建议 /data/app.db
DATABASE_PATH=data/app.db
# HTTPS 部署时设为 1（会话 Cookie 带 Secure）
SESSION_COOKIE_SECURE=0

# ---------------- 微信网页授权（可选） ----------------
# 需要认证服务号 + 网页授权域名；不填则降级为本机匿名身份
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=


# ---------------- 云服务（WorkBuddy Cloud Service） ----------------
# 公开配置（publishableKey / endpoint 可下发前端，不含密钥）
CLOUD_ENDPOINT=
CLOUD_PUBLISHABLE_KEY=
CLOUD_OAUTH_RELAY_BASE_URL=
